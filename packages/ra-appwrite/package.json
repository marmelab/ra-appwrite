{
    "name": "ra-appwrite",
    "version": "1.1.0",
    "repository": "git@github.com:marmelab/ra-appwrite.git",
    "author": "François Zaninotto",
    "license": "MIT",
    "description": "Data and Auth provider for React Admin using Appwrite",
    "files": [
        "*.md",
        "dist",
        "src"
    ],
    "type": "module",
    "zshy": {
        "exports": "./src/index.ts",
        "noEdit": true
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "sideEffects": false,
    "dependencies": {
        "appwrite": "^17.0.0",
        "lodash": "^4.17.21"
    },
    "peerDependencies": {
        "react-admin": "^5.6.0"
    },
    "devDependencies": {
        "react-admin": "^5.6.0",
        "typescript": "^5.1.3",
        "zshy": "^0.5.0"
    },
    "scripts": {
        "build": "zshy --silent",
        "lint": "eslint --fix ./src"
    }
}
